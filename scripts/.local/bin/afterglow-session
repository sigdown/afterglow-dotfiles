#!/usr/bin/env bash

set -euo pipefail

choice="$(
    printf '%s\n' \
        "Lock" \
        "Suspend" \
        "Logout" \
        "Reboot" \
        "Power off" |
        fuzzel --dmenu
)" || exit 0

case "$choice" in
    "Lock")
        pidof hyprlock >/dev/null || hyprlock
        ;;

    "Suspend")
        systemctl suspend
        ;;

    "Logout")
        hyprshutdown -t "Logging out..."
        ;;

    "Reboot")
        hyprshutdown \
            -t "Restarting..." \
            --post-cmd "systemctl reboot"
        ;;

    "Power off")
        hyprshutdown \
            -t "Shutting down..." \
            --post-cmd "systemctl poweroff"
        ;;
esac