# Afterglow notification theme

font=JetBrainsMono Nerd Font 11

background-color=#101A28F2
text-color=#EBC99AFF
progress-color=over #C5662AFF

width=360
height=130

outer-margin=12
margin=6
padding=14

border-size=1
border-color=#2B3441FF
border-radius=4

anchor=top-right
layer=overlay

icons=0
markup=1

max-visible=4
max-history=10

default-timeout=5000
ignore-timeout=1

format=%s\n%b

[urgency=low]
text-color=#C8A982FF
default-timeout=3000

[urgency=critical]
background-color=#31262EF2
text-color=#EBC99AFF
border-color=#C65E49FF
default-timeout=0
