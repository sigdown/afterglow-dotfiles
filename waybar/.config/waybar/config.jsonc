{
    "layer": "top",
    "position": "top",
    "height": 32,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "hyprland/language",
        "memory",
        "pulseaudio",
        "network",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y  %H:%M}",
        "tooltip": false
    },

    "hyprland/language": {
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "RAM {percentage}%",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "tooltip": false
    },

    "network": {
        "format-ethernet": "LAN",
        "format-wifi": "Wi-Fi",
        "format-disconnected": "OFFLINE",
        "tooltip": false,
    },

    "tray": {
        "spacing": 6
    }
}
