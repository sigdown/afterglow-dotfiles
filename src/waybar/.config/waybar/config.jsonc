{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "hyprland/language",
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "network",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by": "number",
        "enable-bar-scroll": false,
        "disable-click": false,
        "tooltip": false
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%d.%m.%Y %H:%M}",
        "tooltip": true,
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "hyprland/language": {
        "format": " {}",
        "format-en": "EN",
        "format-ru": "RU",
        "tooltip": false
    },

    "cpu": {
        "interval": 5,
        "format": " {usage}%",
        "tooltip": true,
        "tooltip-format": "CPU usage: {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 MUTE",
        "format-icons": {
            "default": [
                "",
                " ",
                " "
            ]
        },
        "scroll-step": 2,
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },
    
    "battery": {
    "interval": 30,
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
    ],
    "tooltip": true,
    "tooltip-format": "{capacity}% • {time}"
},

    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈀 LAN",
        "format-disconnected": "󰤭 OFF",
        "format-icons": {
            "wifi": [
                "󰤯",
                "󰤟",
                "󰤢",
                "󰤥",
                "󰤨"
            ]
        },
        "tooltip": true,
        "tooltip-format": "{ifname} • {ipaddr}",
        "tooltip-format-disconnected": "Network disconnected"
    },

    "tray": {
        "icon-size": 17,
        "spacing": 8
    }
}
