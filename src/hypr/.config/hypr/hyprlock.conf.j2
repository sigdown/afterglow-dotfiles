general {
    hide_cursor = true
    ignore_empty_input = true
    fractional_scaling = 1
}

background {
    monitor =
    path = screenshot
    color = rgba({{ colors.surface.base | hex_rgb }}, 1.0)

    blur_passes = 3
    blur_size = 7
    brightness = 0.45
}

label {
    monitor =
    text = LOCKED

    color = rgba({{ colors.accent.primary | hex_rgb }}, 1.0)
    font_size = 14
    font_family = JetBrainsMono Nerd Font

    position = 0, 215
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME

    color = rgba({{ colors.text.primary | hex_rgb }}, 1.0)
    font_size = 108
    font_family = JetBrainsMono Nerd Font

    position = 0, 100
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"

    color = rgba({{ colors.text.secondary | hex_rgb }}, 1.0)
    font_size = 19
    font_family = JetBrainsMono Nerd Font

    position = 0, 5
    halign = center
    valign = center
}

input-field {
    monitor =

    size = 440, 64
    outline_thickness = 2

    inner_color = rgba({{ colors.surface.raised | hex_rgb }}, 0.94)
    outer_color = rgba({{ colors.accent.primary | hex_rgb }}, 1.0)
    font_color = rgba({{ colors.text.primary | hex_rgb }}, 1.0)
    font_family = JetBrainsMono Nerd Font
    placeholder_text = <i>Enter password</i>

    check_color = rgba({{ colors.accent.secondary | hex_rgb }}, 1.0)
    fail_color = rgba({{ colors.status.critical | hex_rgb }}, 1.0)
    capslock_color = rgba({{ colors.status.warning | hex_rgb }}, 1.0)

    dots_size = 0.20
    dots_spacing = 0.30
    dots_center = true

    fade_on_empty = false

    rounding = 10

    position = 0, -120
    halign = center
    valign = center
}
