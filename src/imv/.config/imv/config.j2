[options]
background = {{ colors.surface.base | replace('#', '') }}
scaling_mode = full
overlay = false
overlay_font = JetBrainsMono Nerd Font:16
overlay_text_color = {{ colors.text.primary | replace('#', '') }}
overlay_background_color = {{ colors.surface.raised | replace('#', '') }}
overlay_background_alpha = DD

[binds]
n = next
<Shift+N> = prev
