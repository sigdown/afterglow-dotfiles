#!/usr/bin/env python3

import json
import os
import subprocess
import sys

from _control_menu import menu as pick, notify, require_commands, submenu


def pactl(*args):
    result = subprocess.run(
        ["pactl", *args],
        capture_output=True,
        text=True,
        encoding="utf-8",
        env={**os.environ, "LC_ALL": "C"},
        timeout=5,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Audio server unavailable")
    return result.stdout.strip()


def devices(kind):
    items = json.loads(pactl("--format=json", "list", f"{kind}s"))
    if kind == "source":
        items = [item for item in items if not item.get("monitor_source")]
    return items


def default_device(kind):
    name = pactl(f"get-default-{kind}")
    return next((item for item in devices(kind) if item["name"] == name), None)


def volume(device):
    channels = device.get("volume", {}).values()
    return round(max((channel["value"] for channel in channels), default=0) * 100 / 65536)


def summary(device):
    if device is None:
        return "no device"
    state = " · muted" if device["mute"] else ""
    return f"{volume(device)}%{state}"


def choose_device(kind):
    current = pactl(f"get-default-{kind}")
    choices = []
    entries = []
    for device in devices(kind):
        ports = device.get("ports", [])
        available = [port for port in ports if port.get("availability") != "not available"]
        if ports and not available:
            continue
        for port in available or [None]:
            active = device["name"] == current and (
                port is None or port["name"] == device.get("active_port")
            )
            name = device.get("description") or device["name"]
            if port is not None:
                name = f"{port.get('description') or port['name']} · {name}"
            entries.append(f"{'●' if active else '○'} {name}")
            choices.append((device["name"], port["name"] if port else None))

    if not choices:
        raise RuntimeError("No devices available")
    index = submenu("Output" if kind == "sink" else "Microphone", entries)
    if index is None:
        return False
    name, port = choices[index]
    if port is not None:
        pactl(f"set-{kind}-port", name, port)
    pactl(f"set-default-{kind}", name)
    return True


def choose_volume(kind):
    presets = [0, 10, 25, 50, 75, 100]
    while True:
        device = default_device(kind)
        if device is None:
            raise RuntimeError("No device available for volume control")
        current = volume(device)
        index = submenu(
            f"{'Volume' if kind == 'sink' else 'Microphone level'}: {summary(device)}",
            ["+5%", "−5%", *(f"{value}%" for value in presets)],
        )
        if index is None:
            return
        if index < 2:
            value = min(100, max(0, current + (5 if index == 0 else -5)))
        else:
            value = presets[index - 2]
        pactl(f"set-{kind}-volume", device["name"], f"{value}%")
        if index >= 2:
            return


def device_menu(kind):
    title = "Output" if kind == "sink" else "Microphone"
    while True:
        device = default_device(kind)
        name = (device.get("description") or device["name"]) if device else "no device"
        index = submenu(title, [
            f"Device · {name} ›",
            f"Level · {summary(device)} ›",
            f"{'Unmute' if device and device['mute'] else 'Mute'} {title.lower()}",
        ])
        if index is None:
            return False
        if index == 0:
            if choose_device(kind):
                return True
        elif index == 1:
            choose_volume(kind)
        elif index == 2:
            if device is None:
                raise RuntimeError("No device available to mute or unmute")
            pactl(f"set-{kind}-mute", device["name"], "toggle")


def main():
    require_commands("pactl", "fuzzel")
    while True:
        sink = default_device("sink")
        source = default_device("source")
        index = pick("Audio", [
            "󰕾 Output ›",
            "󰍬 Microphone ›",
        ], message=f"Output {summary(sink)} · Mic {summary(source)}")
        if device_menu("sink" if index == 0 else "source"):
            return


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        message = str(error)
        print(f"control-audio: {message}", file=sys.stderr)
        notify("control-audio", "Audio", message)
        sys.exit(1)
