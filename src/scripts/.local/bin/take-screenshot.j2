#!/usr/bin/env bash

set -euo pipefail

exec 9>"${XDG_RUNTIME_DIR}/take-screenshot.lock"
flock -n 9 || exit 0

geometry="$(slurp -d \
    -b "{{ colors.surface.base }}88" \
    -c "{{ colors.border.focus }}" \
    -F "JetBrainsMono Nerd Font")" || exit 0
[[ -n "$geometry" ]] || exit 0

grim -g "$geometry" - | wl-copy --type image/png
