#!/usr/bin/env python3

import locale
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
import time


def run_fuzzel(args, **kwargs):
    deadline = time.monotonic() + 2
    while True:
        result = subprocess.run(["fuzzel", *args], capture_output=True, text=True, encoding="utf-8", **kwargs)
        if not result.returncode or "failed to acquire lock" not in result.stderr:
            break
        if time.monotonic() >= deadline:
            raise RuntimeError("Fuzzel is busy. Close the other menu and try again.")
        time.sleep(0.05)
    if result.returncode in (1, 2) and not result.stderr.strip():
        raise SystemExit(0)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Failed to open Fuzzel")
    return result.stdout.strip()


def launch(app):
    data_home = os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))
    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    prefix = shlex.join(["env", f"XDG_DATA_HOME={data_home}", f"XDG_DATA_DIRS={data_dirs}"])
    with tempfile.TemporaryDirectory(prefix="control-launcher-") as directory:
        applications = Path(directory) / "applications"
        applications.mkdir()
        (applications / app.get_id()).symlink_to(app.get_filename())
        run_fuzzel(
            ["--auto-select", "--launch-prefix", prefix],
            env={**os.environ, "XDG_DATA_HOME": directory, "XDG_DATA_DIRS": directory},
            stdin=subprocess.DEVNULL,
        )


def main():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio

    os.environ["LC_MESSAGES"] = "C"
    locale.setlocale(locale.LC_MESSAGES, "C")
    apps = sorted(
        (app for app in Gio.AppInfo.get_all() if app.should_show() and app.get_filename()),
        key=lambda app: (app.get_name().casefold(), app.get_id()),
    )
    entries = ["× Close\tClose"]
    for app in apps:
        name = " ".join(app.get_name().split())
        search = " ".join((name, app.get_id(), app.get_string("GenericName") or ""))
        entry = f"{name}\t{' '.join(search.split())}"
        icon = app.get_string("Icon")
        if icon:
            entry += f"\0icon\x1f{icon}"
        entries.append(entry)
    selected = run_fuzzel(
        ["--dmenu", "--index", "--only-match", "--no-sort", "--log-level=error",
         "--with-nth=1", "--match-nth=2", "--prompt", "Apps › ",
         "--placeholder", "Search apps…", *sys.argv[1:]],
        input="\n".join(entries) + "\n",
    )
    try:
        index = int(selected)
    except ValueError:
        return
    if 1 <= index <= len(apps):
        launch(apps[index - 1])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
    except (ImportError, OSError, RuntimeError) as error:
        print(f"control-launcher: {error}", file=sys.stderr)
        sys.exit(1)
