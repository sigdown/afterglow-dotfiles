#!/usr/bin/env bash

set -euo pipefail

confirm() {
    local action="$1" icon="$2" choice
    choice="$(
        printf '%s\n' "← Back" "$icon Confirm $action" |
            fuzzel --dmenu --index --only-match --no-sort \
                --prompt "$action › " \
                --mesg "Applications will close" \
                --lines 2
    )" || exit 0
    [[ "$choice" == 1 ]]
}

while true; do
    choice="$(
        printf '%s\n' \
            "󰌾 Lock" \
            "󰤄 Suspend" \
            "󰍃 Logout" \
            "󰜉 Reboot" \
            "󰐥 Power off" |
            fuzzel --dmenu --index --only-match --no-sort \
                --prompt "Session › " \
                --placeholder "Select…" \
                --lines 5
    )" || exit 0

    case "$choice" in
        0)
            pidof hyprlock >/dev/null || hyprlock
            ;;
        1)
            systemctl suspend
            ;;
        2)
            hyprshutdown -t "Logging out..."
            ;;
        3)
            confirm "Reboot" "󰜉" || continue
            hyprshutdown \
                -t "Restarting..." \
                --post-cmd "systemctl reboot"
            ;;
        4)
            confirm "Power off" "󰐥" || continue
            hyprshutdown \
                -t "Shutting down..." \
                --post-cmd "systemctl poweroff"
            ;;
    esac
    break
done
