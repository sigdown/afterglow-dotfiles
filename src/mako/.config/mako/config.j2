font=JetBrainsMono Nerd Font 11

background-color={{ colors.surface.raised | with_alpha('F2') }}
text-color={{ colors.text.primary | with_alpha }}
progress-color=over {{ colors.accent.primary | with_alpha }}

width=360
height=130

outer-margin=12
margin=6
padding=14

border-size=1
border-color={{ colors.border.subtle | with_alpha }}
border-radius=4

anchor=top-right
layer=overlay

icons=0
markup=1

max-visible=4
max-history=10

default-timeout=5000
ignore-timeout=1

format=%s\n%b

[urgency=low]
text-color={{ colors.text.secondary | with_alpha }}
default-timeout=3000

[urgency=critical]
background-color={{ colors.surface.critical | with_alpha('F2') }}
text-color={{ colors.text.primary | with_alpha }}
border-color={{ colors.status.critical | with_alpha }}
default-timeout=0
