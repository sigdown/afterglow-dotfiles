font=JetBrainsMono Nerd Font 11

# Appearance
background-color={{ colors.surface.raised }}
text-color={{ colors.text.primary }}
progress-color=over {{ colors.accent.primary }}

border-size=2
border-color={{ colors.border.subtle }}
border-radius=10

# Position
anchor=top-center
layer=overlay

# Size & spacing
width=420
outer-margin=12
margin=8
padding=12

# Content
icons=1
markup=1
format=<b>%s</b>\n%b

# Notifications
max-visible=4
max-history=10

default-timeout=5000
ignore-timeout=1

# Mouse actions
# Left click: dismiss
on-button-left=dismiss

# Middle click: do nothing
on-button-middle=none

# Right click: dismiss
on-button-right=dismiss

[urgency=low]
text-color={{ colors.text.secondary }}
default-timeout=3000

[urgency=critical]
background-color={{ colors.status.critical }}
text-color={{ colors.text.primary }}
border-color={{ colors.status.critical }}
default-timeout=0
