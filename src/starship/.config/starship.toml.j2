"$schema" = "https://starship.rs/config-schema.json"

add_newline = false

scan_timeout = 30
command_timeout = 500

format = """
╭─ $directory\
$git_branch\
$git_status\
$cmd_duration\
$time
╰─$character"""


[directory]
style = "bold {{ colors.text.primary }}"
truncation_length = 3
truncation_symbol = "…/"
format = "[$path]($style)"


[git_branch]
symbol = "  "
style = "{{ colors.accent.sky }}"
format = "[$symbol$branch]($style)"


[git_status]
style = "{{ colors.accent.primary }}"

conflicted = "⚔"
ahead = "⇡"
behind = "⇣"
diverged = "⇕"

untracked = "?"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"

format = " [$all_status$ahead_behind]($style)"


[cmd_duration]
min_time = 2000
style = "{{ colors.text.muted }}"
format = " 󰔛 [$duration]($style)"


[time]
disabled = false
time_format = "%H:%M"
style = "{{ colors.text.muted }}"
format = " 󰥔 [$time]($style)"


[character]
success_symbol = "[❯]({{ colors.status.success }})"
error_symbol = "[❯]({{ colors.status.critical }})"
vimcmd_symbol = "[❮]({{ colors.border.focus }})"
